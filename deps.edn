{:paths ["src"]
 ;; kotobase-storage stays zero-dependency on purpose (it sits under every
 ;; provider including Worker builds), which is why the pack decorator lives
 ;; here rather than in it: the CAR codec pulls io-ipld -> cbor and
 ;; multiformats -> @noble/hashes, and that floor is worth keeping.
 ;; 1b84313, not 143b8da: at 143b8da `validate-object-store!` passed a
 ;; computed protocol to `satisfies?`, which is an ordinary function on the
 ;; JVM and under nbb but a compile-time macro in ClojureScript. So
 ;; `kotobase.storage.object` did not build with the ClojureScript compiler,
 ;; and neither did `pack-async`, which requires it. Both suites here are JVM
 ;; or nbb, so both stayed green while the Worker driver -- the whole point of
 ;; `pack-async` -- could not compile. See the note above `:lint` for where
 ;; that build is actually proven, and why it is not proven here.
 :deps {io.github.kotoba-lang/kotobase-storage
        {:git/sha "1b843137fa7cf0a86f86cd052863eb233ad5d421"}
        io.github.kotoba-lang/io-ipld-car
        {:git/sha "4df0605506e601e428475a9277365ed147d25d12"}
        io.github.kotoba-lang/io-ipld
        {:git/sha "8bc2dde5ae47129e49a957131c40313b6b02731c"}
        io.github.kotoba-lang/io-multiformats
        {:git/sha "b3b157e683a943d4f2e9362d9366cceefff3f656"}}
 :aliases
 {;; The S3/R2 adapter is TEST-ONLY and deliberately not a dependency: this
  ;; library composes over any object store, and depending on one provider
  ;; would make the decorator a provider. The end-to-end suite needs it
  ;; because the claim is about a deployment, not about a fixture.
  :r2-test {:extra-paths ["test"]
            :extra-deps {io.github.kotoba-lang/kotobase-storage-s3
                         {:git/sha "e85892327f8fb9bc444e9d006752555801fab0a0"}}}
  :test {:extra-paths ["test"]
         ;; datalog is TEST-ONLY: the catalog ships a vocabulary, quads and
         ;; queries, and composes over whichever datom store the caller has.
         ;; Depending on one engine here would repeat, on the datom plane,
         ;; the mistake this library avoids on the object plane.
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      io.github.kotoba-lang/datalog
                      {:git/sha "44946328354255ad12e17d18ca9394dba066e078"}
                      io.github.kotoba-lang/p2p
                      {:git/sha "3081ca2ad15cb87658e6ebb3fdc330940073c886"}
                      io.github.kotoba-lang/org-ietf-ed25519
                      {:git/sha "fdcefb9f1b83461fee54d04b63e374fa301ee847"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; There is deliberately no `:cljs-compile` alias here, and the reason is
  ;; worth writing down because the obvious one does not work.
  ;;
  ;; `cljs.main -t node -c kotobase.storage.pack-async` fails before it ever
  ;; reaches this library's own code: multiformats requires @noble/hashes
  ;; through npm, and there is no node_modules in a repo that deliberately
  ;; has no package.json. Measured 2026-08-16 -- it failed identically on
  ;; kotobase-storage 143b8da and 1b84313, which is to say it was red for a
  ;; reason unrelated to the bug it was added to catch. A gate that is red
  ;; for everything answers as little as one that is green for everything,
  ;; and shipping it would have looked like coverage.
  ;;
  ;; What actually compiles `pack-async` with the compiler that builds the
  ;; Workers is a consumer that already has shadow-cljs and node_modules:
  ;; `net-kotobase/engine` depends on this library and compiles it on every
  ;; `npm run test:cljs`. That is where this driver's build is proven.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
